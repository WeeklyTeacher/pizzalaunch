local Model = require("../src/server/ProfileModel")
local Config = require("../src/shared/MasteryConfig")
local count = 0
local function test(name, fn) fn(); count += 1; print("PASS: " .. name) end
local function acquired(token)
	return Model.acquire(Config, nil, token or "server-a", 1000)
end
local function loaded(document)
	local model = Model.new(Config)
	model:adopt(document or acquired())
	return model
end
local function delivery(sequence, tableId)
	return { sequence = sequence, tableId = tableId or 6, accuracy = "PERFECT!", customerName = "Mia" }
end

test("confirmed missing profile creates v1 ordinary data without session economy", function()
	local document = acquired()
	assert(Model.validate(Config, document))
	assert(document.schemaVersion == 1 and document.lease.token == "server-a" and document.lease.expiresAt == 1120)
	assert(document.data.coins == nil and document.data.upgrades == nil and next(document.data.pendingFulfillment) == nil)
	assert(document.data.mastery.recordBest == 0)
end)
test("malformed and future documents cannot be replaced by defaults", function()
	for _, old in { false, 123, "unknown", {}, { schemaVersion = 2 }, { schemaVersion = 1, revision = 0 } } do
		local result, reason = Model.acquire(Config, old, "new-server", 1000)
		assert(result == nil and (reason == "malformed" or reason == "unsupported"))
	end
end)
test("session acquisition is exclusive until released or expired", function()
	local old = acquired()
	local competing, reason = Model.acquire(Config, old, "server-b", 1100)
	assert(competing == nil and reason == "locked")
	local retry = Model.acquire(Config, old, "server-a", 1100)
	assert(retry.lease.token == "server-a" and retry.lease.expiresAt == 1220)
	local takeover = Model.acquire(Config, old, "server-b", 1120)
	assert(takeover.lease.token == "server-b")
	assert(old.lease.token == "server-a", "Transform mutated input")
end)
test("failed loading model cannot create a save request", function()
	local model = Model.new(Config)
	model:delivery(delivery(1))
	assert(not pcall(function() model:request("token", false) end))
end)
test("progress during loading adds once to loaded history", function()
	local old = acquired()
	old.data.mastery.deliveries, old.data.mastery.recordBest = 20, 1000
	old.revision = 7
	local model = Model.new(Config)
	model:delivery(delivery(1))
	model:record({ sequence = 1, score = 500 })
	assert(model:adopt(old))
	assert(not model:adopt(old))
	assert(model.data.mastery.deliveries == 21 and model.data.mastery.recordBest == 1000)
	assert(model.revision == 9 and model.savedRevision == 7)
end)
test("delivery receipts use independent monotonic sequence and earn bounded stamps", function()
	local model = loaded()
	assert(model:delivery(delivery(2)))
	assert(not model:delivery(delivery(2)))
	assert(not model:delivery(delivery(1)))
	assert(model:takeout({ sequence = 1 }))
	assert(model.data.mastery.deliveries == 1 and model.data.mastery.perfect == 1 and model.data.mastery.farDeliveries == 1)
	assert(model.data.tableStamps["6"] and model.data.customerStamps.Mia and model.data.mastery.takeout == 1)
end)
test("invalid receipts cannot consume the sequence or mutate progress", function()
	local model = loaded()
	assert(not model:delivery({ sequence = 1, tableId = 7, accuracy = "PERFECT!" }))
	assert(not model:delivery({ sequence = 1, tableId = 1, accuracy = "HACK" }))
	assert(not model:delivery({ sequence = 1, tableId = 1, accuracy = "PERFECT!", customerName = {} }))
	assert(not model:record({ sequence = 1, score = math.huge }))
	assert(not model:record({ sequence = 1, score = -1 }))
	assert(model:delivery(delivery(1)) and model:record({ sequence = 1, score = 900 }))
end)
test("record mastery never lowers a personal tier or duplicates a completion", function()
	local model = loaded()
	model:record({ sequence = 1, score = 1200 })
	model:record({ sequence = 2, score = 400 })
	assert(not model:record({ sequence = 2, score = 9999 }))
	assert(model.data.mastery.recordRuns == 2 and model.data.mastery.recordBest == 1200)
end)
test("earned cosmetics and tutorial completion are idempotent and server gated", function()
	local model = loaded()
	assert(not model:equip("gold") and not model:equip("unknown"))
	for sequence = 1, 15 do model:delivery(delivery(sequence)) end
	assert(model.data.earnedCosmetics.basil and model.data.earnedCosmetics.gold)
	assert(model:equip("gold") and not model:equip("gold"))
	assert(model:completeTutorial() and not model:completeTutorial())
end)
test("immutable request and public snapshots cannot mutate live progression", function()
	local model = loaded()
	model:delivery(delivery(1))
	local request = model:request("server-a", false)
	assert(not pcall(function() request.data.mastery.deliveries = 10000 end))
	local snapshot = model:snapshot()
	snapshot.mastery.deliveries = 10000
	snapshot.earnedCosmetics.gold = true
	assert(model.data.mastery.deliveries == 1 and not model.data.earnedCosmetics.gold)
	assert(snapshot.pendingFulfillment == nil)
end)
test("suspended-save acknowledgement preserves newer dirty mutations", function()
	local model = loaded()
	model:delivery(delivery(1))
	local first = model:request("server-a", false)
	model:delivery(delivery(2))
	model:acknowledge(first)
	assert(model.savedRevision == 1 and model.revision == 2 and model:snapshot().dirty)
end)
test("replayed save transforms are idempotent and renew ownership", function()
	local old = acquired()
	local model = loaded(old)
	model:delivery(delivery(1))
	local request = model:request("server-a", false)
	local first = Model.save(Config, old, request, 1030)
	local second = Model.save(Config, first, request, 1031)
	assert(first.data.mastery.deliveries == 1 and second.data.mastery.deliveries == 1)
	assert(second.lease.expiresAt == 1151 and second.revision == request.revision)
end)
test("stale revision cannot regress equipped items or saved mastery", function()
	local old = acquired()
	old.revision = 20
	local model = loaded()
	local result, reason = Model.save(Config, old, model:request("server-a", false), 1030)
	assert(result == nil and reason == "staleRevision")
end)
test("old server cannot save or release after another server takes ownership", function()
	local old = acquired()
	local model = loaded(old)
	model:delivery(delivery(1))
	local current = Model.acquire(Config, old, "server-b", 1120)
	for _, release in { false, true } do
		local result, reason = Model.save(Config, current, model:request("server-a", release), 1121)
		assert(result == nil and reason == "leaseLost")
	end
	assert(current.data.mastery.deliveries == 0)
end)
test("even unclaimed expired ownership cannot save using a stale clock", function()
	local old = acquired()
	local model = loaded(old)
	local result, reason = Model.save(Config, old, model:request("server-a", false), 1120)
	assert(result == nil and reason == "leaseLost")
end)
test("uncertain final-release retry recognizes only the exact released revision", function()
	local old = acquired()
	local model = loaded(old)
	model:delivery(delivery(1))
	local request = model:request("server-a", true)
	local released = Model.save(Config, old, request, 1030)
	assert(released.lease == nil and released.data.mastery.deliveries == 1)
	local retry = Model.save(Config, released, request, 1031)
	assert(retry and retry.lease == nil and retry.data.mastery.deliveries == 1)
	local nextOwner = Model.acquire(Config, released, "server-b", 1031)
	assert(Model.save(Config, nextOwner, request, 1032) == nil)
end)
test("ordinary future extension data is preserved and never fulfilled", function()
	local old = acquired()
	old.extensions = { note = "preserve" }
	old.data.pendingFulfillment = { future = { state = "reserved" } }
	local model = loaded(old)
	model:takeout({ sequence = 1 })
	local saved = Model.save(Config, old, model:request("server-a", false), 1030)
	assert(saved.extensions.note == "preserve" and saved.data.pendingFulfillment.future.state == "reserved")
end)
test("corrupt nested data is rejected rather than silently repaired", function()
	for _, key in { "mastery", "tableStamps", "customerStamps", "earnedCosmetics", "pendingFulfillment" } do
		local old = acquired()
		old.data[key] = "bad"
		assert(Model.acquire(Config, old, "server-a", 1030) == nil)
	end
	local old = acquired()
	old.data.mastery.perfect = 0 / 0
	assert(Model.acquire(Config, old, "server-a", 1030) == nil)
end)
print(string.format("ProfileModel: %d behavioral tests passed", count))
