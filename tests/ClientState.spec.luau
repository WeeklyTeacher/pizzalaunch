local loadModule = require("./support/LoadModule")
local Input = loadModule("src/client/LauncherInputState.luau")
local Presentation = loadModule("src/client/UIPresentation.luau")

local function snapshot(mode, status, epoch, shot, delay, event, payload)
	return { mode = mode == "none" and "walk" or "launcher", launcherMode = mode, cleanupEpoch = epoch,
		recordRun = { status = status }, shotActive = shot, reloadDelay = delay, event = event, payload = payload }
end
local input = Input.new(0.25, 1.25)
local finger = {}
input:receive(snapshot("select", "idle", 1, false, 0), 0)
assert(not input:begin(finger, 0), "Picker must reject charging without consuming readiness")
assert(input.pendingRequestId == nil)
input:receive(snapshot("freePlay", "idle", 2, false, 0), 0)
assert(input:begin(finger, 0))
local first = input:release(finger, 0.625)
assert(first.charge == 0.5 and first.cleanupEpoch == 2 and first.requestId == 1)
assert(not input:isReady(100), "Elapsed time alone cannot accept or reject a pending request")
input:receive(snapshot("freePlay", "idle", 2, false, 0.25, "launchRejected", { requestId = first.requestId, requestEpoch = 2 }), 1)
assert(input.pendingRequestId == nil and not input:isReady(1) and input:isReady(1.25), "Rejection must honor server reload then recover")
assert(input:begin(finger, 2))
local second = input:release(finger, 2.3)
input:receive(snapshot("freePlay", "idle", 2, false, 0, "launchRejected", { requestId = first.requestId, requestEpoch = 2 }), 2.4)
assert(input.pendingRequestId == second.requestId, "An old reply cannot acknowledge a newer request")
input:receive(snapshot("freePlay", "idle", 2, true, 0.5, "launched", { requestId = second.requestId, requestEpoch = 2 }), 2.5)
assert(not input:isReady(100), "Active authoritative shot cannot reload by local elapsed time")
input:receive(snapshot("freePlay", "idle", 2, false, 0, "shotResult"), 3)
assert(input:isReady(3))
input:receive(snapshot("recordRun", "countdown", 3, false, 0), 4)
assert(input.aimable and not input:begin(finger, 4))
input:receive(snapshot("recordRun", "running", 3, false, 0), 7)
assert(input:begin(finger, 7))
local arrow = {}
input:setTouch("right", arrow, true)
input:step(0.1, 7.2)
assert(input.aimYaw > 0 and input.charge > 0, "Independent fingers must aim and charge simultaneously")
input:setTouch("right", arrow, false)
assert(input.charging and not input.touchHeld.right, "Arrow release must not release fire")
input:setBlocked(true)
assert(not input.charging and input.activeFireInput == nil and not input:release(finger, 8))
input:setBlocked(false)
input:receive(snapshot("none", "idle", 4, false, 0), 9)
input:reset()
input:reset()
assert(not input.charging and input.pendingRequestId == nil and input.aimYaw == 0)
input:receive(snapshot("recordRun", "running", 5, false, 0), 10)
assert(input:begin(finger, 10))
local third = input:release(finger, 10.2)
input:receive(snapshot("recordRun", "running", 5, false, 0, "launchRejected", { requestId = third.requestId, requestEpoch = 3 }), 10.3)
assert(input.pendingRequestId == third.requestId, "Old lease reply must not acknowledge the current pending request")

local view = Presentation.select(snapshot("none", "finished", 1), false, false)
assert(view.upgrades and view.walking and not view.results and not view.controls, "Walking must not resurrect old results")
view = Presentation.select(snapshot("select", "idle", 1), true, false)
assert(view.picker and not view.shop and not view.upgrades and not view.controls)
view = Presentation.select(snapshot("freePlay", "idle", 1), false, false)
assert(view.controls and view.changeMode and view.exit and view.upgrades)
for _, phase in { "saving", "finished" } do
	for _, shop in { true, false } do
		view = Presentation.select(snapshot("recordRun", phase, 1), shop, true)
		assert(not view.controls and view.exit and view.upgrades, "Shop toggles must never restore finished shot controls")
		assert(view.results == not shop)
	end
end
print("PASS: client picker, correlated acceptance/rejection, authoritative reload, touch isolation, epochs and modal presentation")
