local RecordPersistence = require("../src/server/RecordPersistence")
local passed = 0
local function test(name, callback)
	callback()
	passed += 1
	print("PASS: " .. name)
end
local function finish(model, score, id)
	return model:complete(score, id or "run-1", 100, 160)
end

test("completed submission survives mutable run reset and rejects mutation", function()
	local model = RecordPersistence.new(42)
	local run = { score = 1234, id = "original-run" }
	local submission = finish(model, run.score, run.id)
	run.score = 0
	run.id = "next-run"
	assert(submission.userId == 42 and submission.score == 1234 and submission.runId == "original-run")
	assert(submission.startedAt == 100 and submission.completedAt == 160)
	assert(not pcall(function() submission.score = 0 end))
	assert(RecordPersistence.transform(submission, 300) == 1234)
end)

test("failed load cannot create a default write", function()
	local model = RecordPersistence.new(42)
	assert(not model:loaded(false, nil))
	assert(model.savedBest == nil and model.loadStatus == "failed")
	assert(model:beginWrite() == nil and model.pending == nil)
	finish(model, 0)
	assert(model:beginWrite() == nil)
end)

test("new player and failed load remain distinguishable", function()
	local model = RecordPersistence.new(42)
	assert(model:loaded(true, nil))
	assert(model.savedBest == 0 and model.loadStatus == "loaded" and model:available())
	assert(model.pending == nil)
end)

test("late smaller load preserves a completed session best", function()
	local model = RecordPersistence.new(42)
	finish(model, 900)
	model:loaded(true, 400)
	assert(model.sessionBest == 900 and model.savedBest == 400 and model:best() == 900)
	assert(model.pending.score == 900)
end)

test("late larger load subsumes pending score without an unnecessary write", function()
	local model = RecordPersistence.new(42)
	finish(model, 900)
	model:loaded(true, 1200)
	assert(model.sessionBest == 900 and model.savedBest == 1200 and model:best() == 1200)
	assert(model.pending == nil and model:beginWrite() == nil)
end)

test("failed best retries even when the next run scores lower", function()
	local model = RecordPersistence.new(42)
	model:loaded(true, 500)
	finish(model, 1000, "best")
	local first = model:beginWrite()
	assert(not model:resolve(first, false, "outage"))
	assert(model.savedBest == 500 and model.sessionBest == 1000 and model.pending == first)
	finish(model, 700, "lower-next-run")
	local retry = model:beginWrite()
	assert(retry == first and retry.runId == "best")
	assert(model:resolve(retry, true, RecordPersistence.transform(retry, 500)))
	assert(model.savedBest == 1000 and model.pending == nil and model:available())
end)

test("one write per player and a newer better pending score survives acknowledgement", function()
	local model = RecordPersistence.new(42)
	finish(model, 600, "first")
	local first = model:beginWrite()
	assert(model:beginWrite() == nil)
	finish(model, 900, "second")
	assert(model.pending.score == 900 and model.inFlight == first)
	assert(model:resolve(first, true, 600))
	assert(model.savedBest == 600 and model.pending.score == 900)
	local second = model:beginWrite()
	assert(model:resolve(second, true, 900))
	assert(model.savedBest == 900 and model.pending == nil)
end)

test("another server's higher record is preserved by repeated transforms", function()
	local model = RecordPersistence.new(42)
	local submission = finish(model, 700)
	assert(RecordPersistence.transform(submission, nil) == 700)
	assert(RecordPersistence.transform(submission, 600) == 700)
	assert(RecordPersistence.transform(submission, 1400) == 1400)
	model:beginWrite()
	assert(model:resolve(submission, true, 1400))
	assert(model.savedBest == 1400 and model:best() == 1400)
end)

test("malformed history cancels writes instead of coercing to zero", function()
	local model = RecordPersistence.new(42)
	local submission = finish(model, 700)
	for _, invalid in { "1200", {}, -1, 1.5, math.huge, 0 / 0 } do
		assert(RecordPersistence.transform(submission, invalid) == nil)
	end
	model:beginWrite()
	assert(not model:resolve(submission, true, nil))
	assert(model.savedBest == nil and model.pending == submission and not model:available())
end)

test("malformed loads remain unknown and never produce a default write", function()
	local model = RecordPersistence.new(42)
	assert(not model:loaded(true, "unknown"))
	assert(model.savedBest == nil and model.loadStatus == "invalid" and model.pending == nil)
end)

test("stale loads and acknowledgements cannot lower a confirmed best", function()
	local model = RecordPersistence.new(42)
	local first = finish(model, 1100, "first")
	model:beginWrite()
	model:resolve(first, true, 1200)
	model:loaded(true, 400)
	model:loaded(false, nil)
	assert(model.savedBest == 1200 and model.loadStatus == "loaded")
	local second = finish(model, 1600, "second")
	model:beginWrite()
	assert(not model:resolve(first, true, 1300))
	assert(model.inFlight == second and model.savedBest == 1200)
	assert(model:resolve(second, true, 1600))
end)

test("independent players cannot mutate each other's scores or pending writes", function()
	local first, second = RecordPersistence.new(42), RecordPersistence.new(43)
	finish(first, 900)
	finish(second, 200)
	local submission = first:beginWrite()
	assert(not second:resolve(submission, true, 900))
	assert(second:best() == 200 and second.savedBest == nil and second.pending.userId == 43)
end)

test("invalid completed scores are rejected", function()
	local model = RecordPersistence.new(42)
	for _, invalid in { -1, 1.5, math.huge, 0 / 0 } do
		assert(not pcall(function() finish(model, invalid) end))
	end
	assert(model.pending == nil and model.sessionBest == 0)
end)

print(string.format("RecordPersistence: %d behavioral tests passed", passed))
